{
  "_comment": "Microsoft.AspNetCore logging is Warning so request URLs (search text, hub access_token query) never reach logs. The two hub namespaces are pinned explicitly.",
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.EntityFrameworkCore": "Warning", "Microsoft.AspNetCore": "Warning", "Microsoft.AspNetCore.SignalR": "Warning", "Microsoft.AspNetCore.Http.Connections": "Warning" } } },
  "AllowedHosts": "*",
  "Auth": { "Issuer": "dbp", "Audience": "dbp", "AccessMinutes": 15, "RefreshDays": 14, "MaxFailedLogins": 5, "LockMinutes": 15 }
}
