# Copy to db/.env (git-ignored) and set local dev values. Never commit real values.
POSTGRES_OWNER_USER=dbp_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_DB=dbp
POSTGRES_PORT=5433
APP_DB_PASSWORD=
# API signing key, at least 32 characters
JWT_KEY=
# Password given to demo staff by the seed script (dev only)
SEED_STAFF_PASSWORD=
# Server-side pepper for activation-code hashing (HMAC-SHA256), at least 16 characters
CODE_PEPPER=
# Password the mobile e2e gives the fictional demo mothers it activates (dev only)
SEED_MOTHER_PASSWORD=
# Where db/backup/backup.sh writes dumps (default db/backups/, git-ignored). Dumps hold hashes: never commit or share.
BACKUP_DIR=
